# Правила для демо-режима
# Скопируйте этот файл в .htaccess для автоматического переключения на демо-версии

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Перенаправление на демо-версии API
    RewriteCond %{REQUEST_URI} ^/backend/api/auth/login\.php$ [NC]
    RewriteRule ^(.*)$ /backend/api/auth/demo-login.php [L]
    
    RewriteCond %{REQUEST_URI} ^/backend/api/sensors/(current|smart-current)\.php$ [NC]
    RewriteRule ^(.*)$ /backend/api/sensors/demo-current.php [L]
    
    RewriteCond %{REQUEST_URI} ^/backend/api/sensors/(history|user-history)\.php$ [NC]
    RewriteRule ^(.*)$ /backend/api/sensors/demo-history.php [L]
    
    RewriteCond %{REQUEST_URI} ^/backend/api/groups/index\.php$ [NC]
    RewriteRule ^(.*)$ /backend/api/groups/demo-index.php [L]
    
    RewriteCond %{REQUEST_URI} ^/backend/api/groups/sensors\.php$ [NC]
    RewriteRule ^(.*)$ /backend/api/groups/demo-sensors.php [L]
    
    RewriteCond %{REQUEST_URI} ^/backend/api/users/current\.php$ [NC]
    RewriteRule ^(.*)$ /backend/api/users/demo-current.php [L]
    
    RewriteCond %{REQUEST_URI} ^/backend/api/alerts/index\.php$ [NC]
    RewriteRule ^(.*)$ /backend/api/alerts/demo-index.php [L]
</IfModule>
